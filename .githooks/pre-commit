#!/bin/sh
# Pre-commit hook to automatically format code and run clippy.
#
# Pins to the `stable` toolchain explicitly so this hook agrees with
# CI even when a developer's default `rustup` toolchain is nightly.
# The repo's `rust-toolchain.toml` already selects stable, so this is
# belt-and-suspenders — if that file is missing or overridden, we
# still lint against the same clippy version CI enforces.
TOOLCHAIN=stable

echo "Running cargo fmt..."
cargo "+$TOOLCHAIN" fmt --all

# Add any formatted files back to the commit
git diff --name-only --cached | grep '\.rs$' | xargs git add

# Copies the workspace version in Cargo.toml to the web UI, the docs and the
# API spec, and stages each file it changes.
echo "Syncing the version from Cargo.toml..."
PKGID=$(cargo "+$TOOLCHAIN" pkgid -p flowgen)
VERSION=${PKGID##*[@#]}
for dir in web docs; do
    if ! grep -qF "\"version\": \"$VERSION\"" "$dir/package.json"; then
        (cd "$dir" && npm version "$VERSION" --no-git-tag-version >/dev/null) || exit 1
        git add "$dir/package.json" "$dir/package-lock.json"
    fi
done
SPEC=flowgen/api/client/openapi.yaml
if ! grep -qxF "  version: $VERSION" "$SPEC"; then
    sed "1,/^  version: /s/^  version: .*/  version: $VERSION/" "$SPEC" > "$SPEC.tmp" && mv "$SPEC.tmp" "$SPEC"
    git add "$SPEC"
fi

echo "Running cargo clippy (+$TOOLCHAIN)..."
cargo "+$TOOLCHAIN" clippy --workspace --all-targets --all-features -- -D warnings
if [ $? -ne 0 ]; then
    echo ""
    echo "Error: Clippy found issues. Please fix them before committing."
    exit 1
fi

echo "Running cargo test (+$TOOLCHAIN)..."
cargo "+$TOOLCHAIN" test --workspace
if [ $? -ne 0 ]; then
    echo ""
    echo "Error: Tests failed. Please fix them before committing."
    exit 1
fi

# Check if cargo-audit is installed
if command -v cargo-audit >/dev/null 2>&1; then
    echo "Running cargo audit..."
    # Ignored advisories are listed in .cargo/audit.toml.
    cargo audit
    if [ $? -ne 0 ]; then
        echo ""
        echo "Error: Security vulnerabilities found. Please fix them before committing."
        exit 1
    fi
else
    echo "Warning: cargo-audit not installed. Skipping security audit."
    echo "Install with: cargo install cargo-audit"
fi

exit 0
